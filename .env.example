# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Required ---------------------------------------------------------------

# Postgres connection string.
# Supabase: Project Settings > Database > Connection string.
#   - Local dev / one-off scripts: use the direct connection (port 5432).
#   - Vercel serverless: use the TRANSACTION POOLER (port 6543), because each
#     function invocation opens its own connection and the direct endpoint
#     exhausts quickly.
DATABASE_URL=

# Shared password for /admin. Admin is locked for everyone when unset.
ADMIN_PASSWORD=

# Key used to sign the admin session cookie. Any long random string.
# Generate one with: openssl rand -base64 32
# Changing it logs every admin session out.
SESSION_SECRET=

# --- Local dev only ---------------------------------------------------------

# The API server and the Vite dev server each need a PORT, and vite.config.ts
# also requires BASE_PATH. Both throw when unset.
# Note: port 5000 is taken on macOS by the AirPlay Receiver.
PORT=5055
BASE_PATH=/

# --- Optional: AI lineup explainer -----------------------------------------
# Without these, POST /api/player/explain returns 503 and the rest of the app
# works normally.

# Standard OpenAI API key.
OPENAI_API_KEY=

# Model for the explainer. The in-code default `gpt-5.6-terra` is a Replit
# proxy alias that does not exist on the real OpenAI API, so set this to a
# model your account can reach.
EXPLAIN_MODEL=

# Only set these two when running inside Replit, where its AI integration
# provides them. They take precedence over OPENAI_API_KEY when both are set.
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Optional ---------------------------------------------------------------
# LOG_LEVEL=info
